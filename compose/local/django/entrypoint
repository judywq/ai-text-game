#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Fix permissions on media directory (needed for Docker volumes)
# Create media directory structure if it doesn't exist
mkdir -p /app/ai_text_game/media/images
chmod -R 755 /app/ai_text_game/media || true

if [ -z "${POSTGRES_USER}" ]; then
    base_postgres_image_default_user='postgres'
    export POSTGRES_USER="${base_postgres_image_default_user}"
fi
export DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

wait-for-it "${POSTGRES_HOST}:${POSTGRES_PORT}" -t 30

>&2 echo 'PostgreSQL is available'

# Execute the command directly (no user switching needed in local dev)
exec "$@"
